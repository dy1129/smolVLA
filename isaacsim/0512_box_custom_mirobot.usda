def Xform "TableEnv"
{
    def Scope "Materials"
    {
        def Material "TablePhysics" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float dynamicFriction = 0.4
            float restitution = 0.05
            float staticFriction = 0.5
        }

        def Material "ElectricalTape" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float dynamicFriction = 0.7
            float restitution = 0.1
            float staticFriction = 0.9
        }

        def Material "BeltFabric"
        {
            token outputs:surface.connect = </TableEnv/Materials/BeltFabric/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.03, 0.03, 0.03)
                float inputs:metallic = 0
                float inputs:roughness = 0.95
                color3f inputs:specularColor = (0, 0, 0)
                token outputs:surface
            }
        }

        def Material "Cardboard"
        {
            token outputs:surface.connect = </TableEnv/Materials/Cardboard/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76, 0.60, 0.42)
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                color3f inputs:specularColor = (0.05, 0.05, 0.05)
                token outputs:surface
            }
        }

        def Material "WhiteRubber"
        {
            token outputs:surface.connect = </TableEnv/Materials/WhiteRubber/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.95, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                color3f inputs:specularColor = (0.1, 0.1, 0.1)
                token outputs:surface
            }
        }
    }

